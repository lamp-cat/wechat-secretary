<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gly.wechatfrontend</string>
  <key>ProgramArguments</key><array><string>__FRONTEND__/scripts/start.sh</string></array>
  <key>WorkingDirectory</key><string>__FRONTEND__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/wechat_frontend.log</string>
  <key>StandardErrorPath</key><string>/tmp/wechat_frontend.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
</dict>
</plist>
